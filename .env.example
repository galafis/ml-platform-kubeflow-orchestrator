# =============================================================================
# ML Platform Kubeflow Orchestrator - Environment Variables
# =============================================================================
# Copy this file to .env and adjust the values for your environment.
# cp .env.example .env

# --- Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ml_platform
DATABASE_USER=ml_admin
DATABASE_PASSWORD=changeme
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_LOG_LEVEL=info

# --- MLflow ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_REGISTRY_URI=http://mlflow:5000
MLFLOW_ARTIFACT_LOCATION=gs://ml-platform-artifacts/mlflow
MLFLOW_DEFAULT_EXPERIMENT=platform-experiments

# --- Kubeflow Pipeline ---
PIPELINE_NAME=ml-training-pipeline
PIPELINE_NAMESPACE=kubeflow
PIPELINE_EXPERIMENT_NAME=default-experiment
PIPELINE_ROOT=gs://ml-platform-artifacts/pipelines
PIPELINE_SERVICE_ACCOUNT=pipeline-runner

# --- Monitoring ---
MONITORING_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PUSH_GATEWAY=http://prometheus-pushgateway:9091

# --- Quality Gate Thresholds ---
QUALITY_GATE_MIN_ACCURACY=0.85
QUALITY_GATE_MIN_PRECISION=0.80
QUALITY_GATE_MIN_RECALL=0.80
QUALITY_GATE_MIN_F1_SCORE=0.82
QUALITY_GATE_MAX_LATENCY_MS=100.0
QUALITY_GATE_MAX_MODEL_SIZE_MB=500.0

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin
